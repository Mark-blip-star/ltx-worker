# syntax=docker/dockerfile:1.4
# LTX-2.5 CLEAN-ROOM worker (rd/ltx25-cleanroom branch ONLY).
# Purpose: vanilla Lightricks stack for the 2.3-vs-2.5 blind comparison — a fresh clone of
# the upstream LTX-2 repo, their uv env, their distilled CLI. NONE of our 2.3 worker code,
# monkeypatches, or env conventions. The only addition is a ~60-line runpod handler that
# shells out to their `python -m ltx_pipelines.distilled` verbatim.
# Weights are NOT baked: the handler downloads the distilled component set (~73 GB) from the
# gated Lightricks/LTX-2.5 repo on first job (HF_TOKEN env), or finds them pre-seeded.
FROM nvidia/cuda:12.8.0-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 \
    UV_PYTHON_INSTALL_DIR=/opt/uv-python UV_LINK_MODE=copy

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates git ffmpeg gcc libc6-dev libgl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# Vanilla upstream PINNED to the exact commit prod v9.7 runs (was: unpinned clone — every
# build gambled on upstream master). Recorded in /BUILD_COMMIT and reported per job.
ARG LTX2_COMMIT=fd4ded7f2d88d3da713abcdd4ad41ecc4a9314ca
RUN mkdir -p /app/LTX-2 && cd /app/LTX-2 && git init -q && \
    git remote add origin https://github.com/Lightricks/LTX-2 && \
    git fetch -q --depth 1 origin ${LTX2_COMMIT} && git checkout -q FETCH_HEAD && \
    git rev-parse HEAD | tee /BUILD_COMMIT && \
    uv python install 3.12 && uv sync --python 3.12 && uv cache clean
ENV VENV=/app/LTX-2/.venv PATH="/app/LTX-2/.venv/bin:${PATH}"

RUN uv pip install --python "$VENV/bin/python" runpod "huggingface_hub[cli]" && \
    (uv pip install --python "$VENV/bin/python" natten -f https://whl.natten.org || \
     echo "WARN: no natten wheel matched — DiffVAE stays on fallback")

COPY handler_cleanroom.py /app/handler_cleanroom.py
COPY handler_resident.py /app/handler_resident.py
COPY resident_child.py /app/resident_child.py
COPY handler_supervisor.py /app/handler_supervisor.py
WORKDIR /app/LTX-2
CMD ["python", "/app/handler_supervisor.py"]
